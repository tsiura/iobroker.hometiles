{
  "i18n": true,
  "type": "tabs",
  "items": {
    "connection": {
      "type": "panel",
      "label": "tab_connection",
      "items": {
        "brokerHost": { "type": "text", "label": "broker_host", "newLine": true, "sm": 12, "md": 6, "lg": 4 },
        "brokerPort": { "type": "number", "label": "broker_port", "min": 1, "max": 65535, "sm": 12, "md": 3, "lg": 2 },
        "brokerTls": { "type": "checkbox", "label": "broker_tls", "sm": 12, "md": 3, "lg": 2 },
        "brokerUser": { "type": "text", "label": "broker_user", "newLine": true, "sm": 12, "md": 6, "lg": 4 },
        "brokerPassword": { "type": "password", "label": "broker_password", "visible": true, "sm": 12, "md": 6, "lg": 4 },
        "clientId": { "type": "text", "label": "client_id", "newLine": true, "sm": 12, "md": 6, "lg": 4 },
        "baseTopic": { "type": "text", "label": "base_topic", "newLine": true, "sm": 12, "md": 6, "lg": 4, "help": "base_topic_help" },
        "haPrefix": { "type": "text", "label": "ha_prefix", "sm": 12, "md": 6, "lg": 4, "help": "ha_prefix_help" },
        "_testBroker": {
          "type": "sendTo",
          "label": "test_broker",
          "command": "testBroker",
          "jsonData": "{\"brokerHost\": ${JSON.stringify(data.brokerHost ?? '')}, \"brokerPort\": ${JSON.stringify(data.brokerPort ?? null)}, \"brokerTls\": ${JSON.stringify(data.brokerTls ?? false)}, \"brokerUser\": ${JSON.stringify(data.brokerUser ?? '')}, \"brokerPassword\": ${JSON.stringify(data.brokerPassword ?? '')}, \"clientId\": ${JSON.stringify(data.clientId ?? '')}}",
          "result": { "connected": "broker_connected" },
          "error": { "invalid_port": "broker_invalid_port", "failed": "broker_failed", "timeout": "broker_timeout" },
          "showProcess": true,
          "newLine": true,
          "variant": "contained",
          "useNative": true,
          "sm": 12,
          "md": 4,
          "lg": 3
        }
      }
    },
    "devices": {
      "type": "panel",
      "label": "tab_devices",
      "items": {
        "_devicesInfo": { "type": "staticText", "text": "devices_info", "sm": 12, "md": 12, "lg": 12 },
        "_detected": {
          "type": "sendTo",
          "label": "refresh_detected",
          "command": "refreshDetected",
          "jsonData": "{\"rows\": ${JSON.stringify(data.deviceOverrides || [])}, \"pickerArmed\": ${JSON.stringify(data.pickerArmed || null)}}",
          "useNative": true,
          "showProcess": true,
          "result": { "refreshed": "refresh_result" },
          "variant": "contained",
          "newLine": true,
          "sm": 12,
          "md": 4,
          "lg": 3
        },
        "deviceOverrides": {
          "type": "table",
          "label": "detected_devices",
          "newLine": true,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "items": [
            { "type": "checkbox", "attr": "include", "title": "column_include", "width": "7%", "default": false },
            { "type": "text", "attr": "detectedName", "title": "column_detected_name", "width": "16%", "readOnly": true, "filter": true },
            { "type": "text", "attr": "name", "title": "column_name", "width": "14%" },
            { "type": "text", "attr": "detectedDomain", "title": "column_domain", "width": "9%", "readOnly": true, "filter": true },
            {
              "type": "select",
              "attr": "forcedDomain",
              "title": "column_forced_domain",
              "width": "12%",
              "options": [
                { "label": "domain_auto", "value": "" },
                { "label": "domain_sensor", "value": "sensor" },
                { "label": "domain_binary_sensor", "value": "binary_sensor" },
                { "label": "domain_switch", "value": "switch" },
                { "label": "domain_light", "value": "light" },
                { "label": "domain_scene", "value": "scene" },
                { "label": "domain_climate", "value": "climate" },
                { "label": "domain_cover", "value": "cover" },
                { "label": "domain_media_player", "value": "media_player" },
                { "label": "domain_weather", "value": "weather" },
                { "label": "domain_number", "value": "number" },
                { "label": "domain_select", "value": "select" },
                { "label": "domain_datetime", "value": "datetime" }
              ]
            },
            { "type": "text", "attr": "room", "title": "column_room", "width": "14%", "readOnly": true, "filter": true },
            { "type": "text", "attr": "objectId", "title": "column_object_id", "width": "18%", "readOnly": true, "filter": true, "default": "" },
            {
              "type": "sendTo",
              "attr": "_preview",
              "title": "column_preview",
              "label": "preview_entity",
              "command": "previewEntity",
              "jsonData": "{\"objectId\": ${JSON.stringify(data.objectId ?? '')}, \"forcedDomain\": ${JSON.stringify(data.forcedDomain ?? '')}, \"name\": ${JSON.stringify(data.name ?? '')}, \"rows\": ${JSON.stringify(globalData?.deviceOverrides ?? null)}, \"climateModes\": ${JSON.stringify(globalData?.climateModes ?? null)}}",
              "error": { "device_not_detected": "preview_not_detected", "no_usable_channel": "preview_no_entity" },
              "variant": "outlined",
              "width": "10%"
            }
          ]
        },
        "_manualInfo": { "type": "staticText", "text": "manual_info", "newLine": true, "sm": 12, "md": 12, "lg": 12 },
        "manualEntities": {
          "type": "table",
          "label": "manual_entities",
          "newLine": true,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "items": [
            { "type": "objectId", "attr": "stateId", "title": "column_state_id", "width": "40%", "types": ["state"], "default": "" },
            {
              "type": "select",
              "attr": "domain",
              "title": "column_domain",
              "width": "20%",
              "default": "sensor",
              "options": [
                { "label": "domain_sensor", "value": "sensor" },
                { "label": "domain_binary_sensor", "value": "binary_sensor" },
                { "label": "domain_switch", "value": "switch" },
                { "label": "domain_scene", "value": "scene" },
                { "label": "domain_number", "value": "number" },
                { "label": "domain_select", "value": "select" },
                { "label": "domain_datetime", "value": "datetime" }
              ]
            },
            { "type": "text", "attr": "name", "title": "column_name", "width": "20%", "default": "" },
            {
              "type": "select",
              "attr": "kind",
              "title": "column_kind",
              "width": "20%",
              "default": "",
              "disabled": "data.domain !== 'datetime'",
              "options": [
                { "label": "kind_none", "value": "" },
                { "label": "kind_date", "value": "date" },
                { "label": "kind_time", "value": "time" },
                { "label": "kind_datetime", "value": "datetime" }
              ]
            }
          ]
        },
        "_climateModesInfo": { "type": "staticText", "text": "climate_modes_info", "newLine": true, "sm": 12, "md": 12, "lg": 12 },
        "climateModes": {
          "type": "table",
          "label": "climate_modes",
          "newLine": true,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "items": [
            {
              "type": "selectSendTo",
              "attr": "device",
              "title": "column_climate_device",
              "width": "45%",
              "command": "climateDevices",
              "noTranslation": true,
              "default": ""
            },
            { "type": "text", "attr": "deviceMode", "title": "column_device_mode", "width": "30%", "default": "" },
            {
              "type": "select",
              "attr": "panelMode",
              "title": "column_panel_mode",
              "width": "25%",
              "options": [
                { "label": "hvac_off", "value": "off" },
                { "label": "hvac_heat", "value": "heat" },
                { "label": "hvac_cool", "value": "cool" },
                { "label": "hvac_heat_cool", "value": "heat_cool" },
                { "label": "hvac_auto", "value": "auto" },
                { "label": "hvac_dry", "value": "dry" },
                { "label": "hvac_fan_only", "value": "fan_only" }
              ]
            }
          ]
        }
      }
    },
    "energy": {
      "type": "panel",
      "label": "tab_energy",
      "items": {
        "_energyInfo": { "type": "staticText", "text": "energy_info", "sm": 12, "md": 12, "lg": 12 },
        "energyMeters": {
          "type": "table",
          "label": "energy_meters",
          "newLine": true,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "uniqueColumns": ["stateId"],
          "items": [
            { "type": "objectId", "attr": "stateId", "title": "column_state_id", "width": "35%", "types": ["state"], "default": "" },
            {
              "type": "select",
              "attr": "category",
              "title": "column_category",
              "width": "15%",
              "default": "grid",
              "options": [
                { "label": "category_grid", "value": "grid" },
                { "label": "category_solar", "value": "solar" },
                { "label": "category_battery", "value": "battery" },
                { "label": "category_gas", "value": "gas" },
                { "label": "category_water", "value": "water" },
                { "label": "category_device", "value": "device" },
                { "label": "category_device_water", "value": "device_water" }
              ]
            },
            {
              "type": "select",
              "attr": "sign",
              "title": "column_sign",
              "width": "15%",
              "default": 1,
              "options": [
                { "label": "sign_import", "value": 1 },
                { "label": "sign_export", "value": -1, "hidden": "data.category === 'device' || data.category === 'device_water'" }
              ]
            },
            { "type": "text", "attr": "name", "title": "column_name", "width": "20%", "default": "" },
            { "type": "number", "attr": "price", "title": "column_price", "width": "15%", "min": 0, "step": 0.0001 }
          ]
        },
        "currency": { "type": "text", "label": "currency", "newLine": true, "sm": 12, "md": 4, "lg": 3, "maxLength": 8, "help": "currency_help" }
      }
    },
    "panels": {
      "type": "panel",
      "label": "tab_panels",
      "items": {
        "_pairInfo": { "type": "staticText", "text": "pair_info", "sm": 12, "md": 12, "lg": 12 },
        "_pairHost": { "type": "text", "label": "pair_host", "help": "pair_host_help", "newLine": true, "sm": 12, "md": 4, "lg": 3 },
        "_pairPanel": {
          "type": "sendTo",
          "label": "pair_panel",
          "command": "pairPanel",
          "jsonData": "{\"host\": ${JSON.stringify(data._pairHost ?? '')}}",
          "result": { "paired": "pair_done" },
          "error": {
            "invalid_host": "pair_invalid_host",
            "unreachable": "pair_unreachable",
            "credentials_rejected": "pair_credentials_rejected",
            "restart_unreachable": "pair_restart_unreachable",
            "restart_failed": "pair_restart_failed",
            "password_unreadable": "pair_password_unreadable"
          },
          "showProcess": true,
          "variant": "contained",
          "useNative": true,
          "sm": 12,
          "md": 4,
          "lg": 3
        }
      }
    },
    "advanced": {
      "type": "panel",
      "label": "tab_advanced",
      "items": {
        "historyInstance": { "type": "instance", "adapter": "_dataSources", "label": "history_instance", "sm": 12, "md": 4, "lg": 3, "help": "history_instance_help" },
        "coalesceMs": { "type": "number", "label": "coalesce_ms", "min": 0, "max": 5000, "sm": 12, "md": 4, "lg": 3, "help": "coalesce_ms_help" },
        "maxPublishQueue": { "type": "number", "label": "max_publish_queue", "min": 100, "max": 100000, "sm": 12, "md": 4, "lg": 3, "help": "max_publish_queue_help" },
        "protocolTrace": { "type": "checkbox", "label": "protocol_trace", "newLine": true, "sm": 12, "md": 4, "lg": 3, "help": "protocol_trace_help" }
      }
    }
  }
}
